<?xml version="1.0" encoding="utf-8"?>
<!-- Main layout for the Stock fragment showing inventory and quick actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Top toolbar displaying screen title and hosting the Options Menu -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/stocksense_dark"
        app:title="@string/title_stock_list"
        app:titleTextColor="@color/white" />

    <!-- Action bar with buttons to add a new product or record a new sale -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white">

        <!-- Opens the Add Product screen -->
        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/title_add_product"
            android:textColor="@color/white"
            android:backgroundTint="@color/stocksense_primary"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- Opens the New Sale screen -->
        <Button
            android:id="@+id/btnGoNewSale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/btn_new_sale"
            android:textColor="@color/stocksense_text"
            android:backgroundTint="@color/stocksense_accent"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Message displayed when the shop owner has no products yet -->
    <TextView
        android:id="@+id/tvEmptyStock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/empty_stock_message"
        android:textSize="16sp"
        android:textColor="@color/stocksense_text"
        android:visibility="gone" />

    <!-- Scrollable list of the owner's products -->
    <ListView
        android:id="@+id/lvProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/stocksense_dark"
        android:dividerHeight="1dp" />

</LinearLayout>