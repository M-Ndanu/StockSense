<?xml version="1.0" encoding="utf-8"?>
<!-- Row layout representing a single product item in the Stock ListView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutProductRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@color/white">

    <ImageView
        android:id="@+id/ivItemImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/img_placeholder"
        android:contentDescription="@string/polish_desc_item_image"
        android:scaleType="centerCrop" />

    <!-- Left container holding product name, category, and price -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Displays the product name -->
        <TextView
            android:id="@+id/tvItemProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/stocksense_text" />

        <!-- Displays the product category -->
        <TextView
            android:id="@+id/tvItemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/stocksense_dark"
            android:layout_marginTop="2dp" />

        <!-- Displays the selling price in whole shillings -->
        <TextView
            android:id="@+id/tvItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/stocksense_primary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Right container holding current stock count and low-stock warning badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Displays the remaining quantity in stock -->
        <TextView
            android:id="@+id/tvItemStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/stocksense_text" />

        <!-- Alert badge shown only when stock is at or below reorder level -->
        <TextView
            android:id="@+id/tvLowStockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_low_stock"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/stocksense_alert"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnItemMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/polish_desc_item_more"
        android:focusable="false"
        android:src="@drawable/ic_more_vert" />

</LinearLayout>
