<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stocksense_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Green header with back arrow and the screen title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stocksense_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/polish_desc_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvAddEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/title_add_product"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Input field for product name -->
        <EditText
            android:id="@+id/etProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_product_name"
            android:inputType="textCapWords"
            android:textColor="@color/stocksense_text"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- Input field for product category -->
        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_category"
            android:inputType="textCapWords"
            android:textColor="@color/stocksense_text"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- Input field for selling price in whole shillings -->
        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_price"
            android:inputType="number"
            android:textColor="@color/stocksense_text"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- Input field for current available stock quantity -->
        <EditText
            android:id="@+id/etStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_stock"
            android:inputType="number"
            android:textColor="@color/stocksense_text"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- Input field for low-stock reorder threshold -->
        <EditText
            android:id="@+id/etReorderLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/hint_reorder_level"
            android:inputType="number"
            android:textColor="@color/stocksense_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Button to validate inputs and save the product to SQLite -->
        <Button
            android:id="@+id/btnSaveProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_save_product"
            android:textColor="@color/white"
            android:backgroundTint="@color/stocksense_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
</LinearLayout>
