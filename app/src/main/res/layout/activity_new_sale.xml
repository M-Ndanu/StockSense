<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/stocksense_dark"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stocksense_dark"
        android:padding="16dp"
        android:text="@string/sales_title_new_sale"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <Spinner
            android:id="@+id/spProducts"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/sales_hint_quantity"
            android:inputType="number" />

        <Button
            android:id="@+id/btnAddItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stocksense_primary"
            android:minHeight="48dp"
            android:text="@string/sales_btn_add_item"
            android:textColor="@color/white" />

        <ListView
            android:id="@+id/lvCart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/stocksense_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stocksense_dark"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btnRecordSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/stocksense_accent"
            android:minHeight="48dp"
            android:text="@string/sales_btn_record"
            android:textColor="@color/stocksense_text" />

    </LinearLayout>
</LinearLayout>
